#!/usr/bin/env bash
# Heuristic co-change gate. Reads one staged path per line on stdin.
set -euo pipefail

core_source_changed=false
core_test_changed=false
lab_source_changed=false
lab_test_changed=false
load_source_changed=false
load_test_changed=false
fixture_source_changed=false
fixture_test_changed=false

while IFS= read -r path; do
  case "$path" in
    lib/*|src/*) core_source_changed=true ;;
    test/*) core_test_changed=true ;;
    tools/insider_lab/lib/*) lab_source_changed=true ;;
    tools/insider_lab/test/*) lab_test_changed=true ;;
    tools/insider_load/lib/*) load_source_changed=true ;;
    tools/insider_load/test/*) load_test_changed=true ;;
    fixtures/apps/*) fixture_source_changed=true ;;
    fixtures/scenarios/*) fixture_test_changed=true ;;
  esac
done

if { [ "$core_source_changed" = true ] && [ "$core_test_changed" = false ]; } ||
   { [ "$lab_source_changed" = true ] && [ "$lab_test_changed" = false ]; } ||
   { [ "$load_source_changed" = true ] && [ "$load_test_changed" = false ]; } ||
   { [ "$fixture_source_changed" = true ] && [ "$fixture_test_changed" = false ]; }; then
  echo "[pre-commit] behavior-bearing source changed without staged tests" >&2
  echo "[pre-commit] add or strengthen a focused test in the same commit" >&2
  exit 1
fi
